{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/feedback/**",
              "components/overlays/**",
              "components/primitives/**",
              "components/shell/**",
              "ui_kits/admin-console/**",
              "ui_kits/brand-console/**",
              "ui_kits/sales-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Readex Pro|Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: Readex Pro, Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|title|children|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, icon, title, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|info|wait|destructive)$/]",
        "message": "<Alert> variant must be one of 'default' | 'info' | 'wait' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|count|urgent|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon, count, urgent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|square|className|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, square, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'default' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|destructive|count)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'outline' | 'destructive' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|ghost|destructive|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default|lg|icon|tap)$/]",
        "message": "<Button> size must be one of 'sm' | 'default' | 'lg' | 'icon' | 'tap'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:flat|interactive|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: flat, interactive, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onCheckedChange|disabled|label|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, onCheckedChange, disabled, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestructiveSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|consequences|confirmLabel|cancelLabel|onConfirm|onClose|children|key|ref|className|style|children)$/]",
        "message": "<DestructiveSheet> doesn't accept that prop. Declared props: open, title, description, consequences, confirmLabel, cancelLabel, onConfirm, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|unit|className|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid, unit, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:optional|className|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: optional, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListState'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|rows|title|body|actionLabel|onAction|requiredRole|className|key|ref|className|style|children)$/]",
        "message": "<ListState> doesn't accept that prop. Declared props: state, rows, title, body, actionLabel, onAction, requiredRole, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListState'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:loading|empty|error|denied)$/]",
        "message": "<ListState> state must be one of 'loading' | 'empty' | 'error' | 'denied'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:hint|secondary|children|className|key|ref|className|style|children)$/]",
        "message": "<MobileActionBar> doesn't accept that prop. Declared props: hint, secondary, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|variant|locale|creditLabel|debitLabel|zeroLabel|note|className|key|ref|className|style|children)$/]",
        "message": "<MoneyRow> doesn't accept that prop. Declared props: amount, variant, locale, creditLabel, debitLabel, zeroLabel, note, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|row|inline)$/]",
        "message": "<MoneyRow> variant must be one of 'hero' | 'row' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyRow'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<MoneyRow> locale must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|marks|className|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, tone, marks, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|wait|bad)$/]",
        "message": "<Progress> tone must be one of 'default' | 'wait' | 'bad'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResponsiveList'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|renderCard|onRowClick|locale|className|key|ref|className|style|children)$/]",
        "message": "<ResponsiveList> doesn't accept that prop. Declared props: columns, rows, renderCard, onRowClick, locale, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResponsiveList'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<ResponsiveList> locale must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|className|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Separator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|side|title|description|footer|onClose|children|className|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, side, title, description, footer, onClose, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:bottom|start)$/]",
        "message": "<Sheet> side must be one of 'bottom' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|className|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:enumName|value|locale|size|className|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: enumName, value, locale, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='enumName'] > Literal[value!=/^(?:BrandOrderStatus|ReturnStatus|SettlementStatus|ProductStatus|BrandStatus)$/]",
        "message": "<StatusPill> enumName must be one of 'BrandOrderStatus' | 'ReturnStatus' | 'SettlementStatus' | 'ProductStatus' | 'BrandStatus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<StatusPill> locale must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default)$/]",
        "message": "<StatusPill> size must be one of 'sm' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onCheckedChange|disabled|label|hint|className|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onCheckedChange, disabled, label, hint, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|num|render|key|ref|className|style|children)$/]",
        "message": "<Column> doesn't accept that prop. Declared props: key, label, align, num, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Column> align must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|className|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid, className."
      }
    ]
  },
